    "@fontsource-variable/geist": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "motion": "12.43.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/cli": "4.3.3"
  }
}
